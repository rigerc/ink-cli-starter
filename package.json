{
  "name": "ink-kit",
  "version": "0.1.0",
  "description": "GitHub template for an Ink 8, React 19 and TypeScript terminal application",
  "bin": {
    "ink-kit": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "gallery": "tsx src/cli.tsx --screen gallery",
    "build": "vp pack",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "check": "vp check",
    "test": "vp test run",
    "screenshot": "node --import tsx scripts/screenshot.tsx",
    "start": "node dist/cli.js",
    "prepare": "vp config",
    "theme": "node scripts/theme.mjs",
    "theme:list": "node scripts/theme.mjs list",
    "theme:token": "node scripts/theme.mjs token",
    "theme:default": "node scripts/theme.mjs default",
    "record": "node --import tsx scripts/screenshot.tsx --video"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "meow": "^14.1.0",
    "react": "^19.3.1",
    "string-width": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.88.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5",
    "oxlint": "1.88.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
