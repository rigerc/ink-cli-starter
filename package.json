{
  "name": "ink-kit",
  "version": "0.1.0",
  "description": "Ink 8 CLI skeleton with a theme system, hooks, helpers and a component library",
  "type": "module",
  "bin": {
    "ink-kit": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "gallery": "tsx src/cli.tsx --screen gallery",
    "demo:inline": "node --import tsx src/cli.tsx --demo",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "meow": "^14.1.0",
    "react": "^19.3.1",
    "string-width": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
