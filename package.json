{
  "name": "ink-kit",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub template for an Ink 8, React 19 and TypeScript terminal application",
  "license": "Apache-2.0",
  "bin": {
    "ink-kit": "./dist/cli.js"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "init:project": "node scripts/init-project.mjs",
    "build": "vp pack",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "vp lint",
    "check": "npm run check:template && vp check",
    "check:template": "node scripts/check-template.mjs",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:pty": "vp test run tests/terminal-pty.test.ts",
    "start": "node dist/cli.js",
    "prepare": "vp config",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only",
    "release": "npm run build && changeset publish",
    "release:tag": "changeset git-tag",
    "update:agents": "node scripts/update-agents-md.mjs --write",
    "check:agents": "node scripts/update-agents-md.mjs --check",
    "update:skill": "node scripts/sync-skill.mjs --write",
    "check:skill": "node scripts/sync-skill.mjs --check"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "commander": "^15.0.0",
    "conf": "^16.0.0",
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@oxlint/plugins": "1.89.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@typescript/typescript6": "6.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "ink-testing-library": "^4.0.0",
    "oxlint": "1.89.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
