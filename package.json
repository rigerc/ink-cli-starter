{
  "name": "ink-kit",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub template for an Ink 8, React 19 and TypeScript terminal application",
  "bin": {
    "ink-kit": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "build": "vp pack",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "check": "npm run check:template && vp check",
    "check:template": "node scripts/check-template.mjs",
    "test": "vp test run",
    "screenshot": "node --import tsx scripts/screenshot.tsx",
    "start": "node dist/cli.js",
    "prepare": "vp config",
    "theme": "node scripts/theme.mjs",
    "theme:list": "node scripts/theme.mjs list",
    "theme:token": "node scripts/theme.mjs token",
    "theme:default": "node scripts/theme.mjs default",
    "record": "node --import tsx scripts/screenshot.tsx --video",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only",
    "release": "npm run build && changeset publish",
    "release:tag": "changeset tag"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "commander": "^15.0.0",
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "string-width": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@oxlint/plugins": "1.89.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "oxlint": "1.89.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
